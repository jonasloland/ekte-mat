# Kopier til .env og fyll inn. .env skal ALDRI committes.
SECRET_KEY=bytt-meg-til-en-lang-tilfeldig-streng
# Valgfritt: brukes til å generere rettbilder fra instruks (A2).
# Uten nøkkel lages en plassholder-illustrasjon.
ANTHROPIC_API_KEY=
# IMAGE_MODEL=claude-opus-5-5
# DAILY_GUEST_CAPACITY=400

# Lagring: "sqlite" (standard) eller "neo4j". Neo4j må kjøre, se README («Kjøre med Neo4j»).
STORAGE_BACKEND=sqlite
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ektemat-passord
